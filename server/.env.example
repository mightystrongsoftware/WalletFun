PORT=3000
PUBLIC_API_BASE_URL=http://127.0.0.1:3000
WEB_ORIGIN=http://127.0.0.1:3001
CONTENT_PROVIDER=memory

# Required when CONTENT_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Apple Wallet values. Keep certs and keys outside Git.
APPLE_PASS_TYPE_IDENTIFIER=
APPLE_TEAM_IDENTIFIER=
APPLE_WWDR_CERT_PATH=
APPLE_WWDR_CERT_PEM=
APPLE_PASS_CERT_PATH=
APPLE_PASS_CERT_PEM=
APPLE_PASS_KEY_PATH=
APPLE_PASS_KEY_PEM=
APPLE_PASS_CERT_PASSWORD=
APPLE_PUSH_UPDATES_ENABLED=true
APPLE_APNS_PRODUCTION=true

# Google Wallet values. Keep the service account JSON outside Git.
# Issuer ID from the Google Pay & Wallet Console; the class suffix names the
# single WalletFun generic pass class (<issuerId>.<suffix>).
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_CLASS_SUFFIX=walletfun
# Service account with the "Google Wallet API" enabled and added to the issuer
# account. Provide the JSON key file contents or a path to it.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_PATH=
# Optional comma-separated web origins allowed to host the save link.
GOOGLE_WALLET_ORIGINS=
GOOGLE_WALLET_UPDATES_ENABLED=true
